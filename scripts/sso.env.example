# Copy to scripts/sso.env (git-ignored) and fill in, then run ./scripts/setup-sso.sh

# Supabase personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# From Google Cloud Console → Credentials → OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# From Facebook for Developers → your app → Settings → Basic
FACEBOOK_CLIENT_ID=
FACEBOOK_SECRET=
