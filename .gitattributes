# Keep the Gradle wrapper script LF so it runs on the Linux CI runner.
gradlew text eol=lf
*.sh text eol=lf

# Windows batch files stay CRLF.
*.bat text eol=crlf

# Treat the wrapper jar and images as binary.
*.jar binary
*.png binary
*.jpg binary
*.webp binary

# Normalise source files.
*.kt text
*.kts text
*.xml text
*.md text
*.yml text
