# Copy to keystore.properties (git-ignored) and fill in to build a signed release.
# Generate the keystore with:
#   keytool -genkey -v -keystore shoplocal-release.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias shoplocal
storeFile=../shoplocal-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=shoplocal
keyPassword=YOUR_KEY_PASSWORD
