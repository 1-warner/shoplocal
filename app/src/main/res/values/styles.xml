<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Section header used between groups on the Settings screen. -->
    <style name="SettingsSection" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/brand_green</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Pill active indicator for the bottom nav -->
    <style name="ShopLocal.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/brand_green_light</item>
        <item name="android:width">60dp</item>
        <item name="android:height">34dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.ShopLocal.Large</item>
    </style>
</resources>
